{
  "expo": {
    "name": "Cappers & Code",
    "slug": "cappers-and-code",
    "version": "0.1.0",
    "scheme": "cappers",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050608"
    },
    "newArchEnabled": true,
    "backgroundColor": "#050608",
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.cappersandcode.app" },
    "android": {
      "package": "com.cappersandcode.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050608"
      }
    },
    "web": { "bundler": "metro", "output": "static", "favicon": "./assets/favicon.png" },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "extra": {
      "boardUrl": "https://api.github.com/repos/mackpittman/cappers-and-code/contents/data/board.json?ref=main"
    }
  }
}
