{
  "name": "cappers-and-code",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Cappers & Code - NFL touchdown board with daily research updates and live odds tracking.",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "update:odds": "node scripts/fetch-odds.mjs",
    "update:injuries": "node scripts/fetch-injuries.mjs",
    "update:schedule": "node scripts/fetch-schedule.mjs",
    "build:board": "node scripts/build-board.mjs",
    "cfb": "node scripts/fetch-cfb.mjs",
    "sheets": "node scripts/build-sheets.mjs",
    "update:daily": "node scripts/fetch-schedule.mjs && node scripts/fetch-injuries.mjs && node scripts/fetch-odds.mjs && node scripts/grade-results.mjs && node scripts/build-board.mjs && node scripts/publish-board.mjs && node scripts/post-discord.mjs",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,yml}\"",
    "post:discord": "node scripts/post-discord.mjs",
    "publish:board": "node scripts/publish-board.mjs",
    "grade": "node scripts/grade-results.mjs",
    "validate:research": "node scripts/validate-research.mjs",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "build:web": "expo export --platform web --output-dir dist/app && node scripts/postbuild-web.mjs dist/app",
    "build:site": "rm -rf dist && node scripts/build-site.mjs dist && pnpm build:web"
  },
  "dependencies": {
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.116.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "~0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@expo/ngrok": "^4.1.3",
    "@react-native/metro-config": "0.86.3",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.11",
    "prettier": "3.3.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
