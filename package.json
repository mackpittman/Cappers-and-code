{
  "name": "cappers-and-code",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Cappers & Code - NFL touchdown board with daily research updates and live odds tracking.",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "update:odds": "node scripts/fetch-odds.mjs",
    "update:injuries": "node scripts/fetch-injuries.mjs",
    "update:schedule": "node scripts/fetch-schedule.mjs",
    "build:board": "node scripts/build-board.mjs",
    "update:daily": "node scripts/fetch-schedule.mjs && node scripts/fetch-injuries.mjs && node scripts/fetch-odds.mjs && node scripts/build-board.mjs",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,yml}\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "1.23.1",
    "expo": "~52.0.11",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.9",
    "expo-splash-screen": "~0.29.13",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.3",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.1.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "5.6.3",
    "prettier": "3.3.3"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
